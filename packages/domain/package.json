{
  "name": "@money/domain",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-agnostic domain logic shared by the Money Manager Angular frontend and Express backend. See docs/adr/0005-domain-package-structure.md.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
