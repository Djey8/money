  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.6.4",
    "globals": "^17.12.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.6",
    "typescript": "~5.9.3"
  }
}
